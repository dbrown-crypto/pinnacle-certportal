# .env.example — backend environment variables for the Pinnacle certificate portal.
#
# Copy to `.env` for LOCAL runs only. In production, set these in the Render
# (or Railway) dashboard, NOT in a committed file.
# .env is already excluded by .gitignore — never commit real keys.
#
# Where to find each value:
#   Supabase → Project Settings → API   (URL, anon key, service_role key, JWT secret)
#   Resend   → API Keys                  (after verifying the pinnacleriskad.com domain)

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://dvjnnhwuamwcvqoxmske.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # SECRET — server only, bypasses RLS. Never expose.
SUPABASE_JWT_SECRET=              # SECRET — verifies client login sessions

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=                   # SECRET — set after verifying pinnacleriskad.com
MAIL_FROM=Pinnacle Risk Advisors <certs@pinnacleriskad.com>
AGENT_NOTIFY_EMAIL=dbrown@pinnacleriskad.com

# --- Admin access -----------------------------------------------------------
# Derrick's Supabase Auth user UUID(s), comma-separated. Only these can reach
# the /admin endpoints. Get the UUID after creating your login (BUILD_BRIEF Task 7).
ADMIN_USER_IDS=

# --- CORS -------------------------------------------------------------------
# Your deployed Netlify URL(s), comma-separated. Set after the frontend deploys.
ALLOWED_ORIGINS=https://YOUR-PORTAL.netlify.app

# --- Real ACORD 25 (leave blank during the sample-cert phase) ---------------
# Set these only when wiring your licensed template + signature (BUILD_BRIEF
# final section). Blank = branded SAMPLE certificate.
ACORD25_TEMPLATE_PATH=
SIGNATURE_PNG_PATH=

# Note: the frontend (index.html / admin.html) does NOT read this file. Its
# config block holds SUPABASE_URL, the ANON key (public, safe), and BACKEND_URL.
